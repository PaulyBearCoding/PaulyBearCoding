{
  "name": "gjyl",
  "version": "1.0.0",
  "private": true,
  "description": "GJYL - Chat, Feed, and Live social platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter web dev\" \"pnpm --filter api dev\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "playwright test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "db:migrate": "cd infra/prisma && prisma migrate dev",
    "db:migrate:prod": "cd infra/prisma && prisma migrate deploy",
    "db:seed": "cd infra/prisma && tsx seed.ts",
    "db:studio": "cd infra/prisma && prisma studio",
    "db:generate": "cd infra/prisma && prisma generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/node": "^20.10.6",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "prettier": "^3.1.1",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.14.0"
}
