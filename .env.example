# Database
DATABASE_URL="postgresql://gjyl:gjyl_password@localhost:5432/gjyl?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# S3 Compatible Storage (MinIO in dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="gjyl_minio"
S3_SECRET_KEY="gjyl_minio_secret_key_2024"
S3_BUCKET="gjyl-uploads"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9000/gjyl-uploads"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Email (for magic links)
EMAIL_SERVER="smtp://user:password@localhost:1025"
EMAIL_FROM="noreply@gjyl.local"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Brand
NEXT_PUBLIC_BRAND_NAME="GJYL"
NEXT_PUBLIC_BRAND_TAGLINE="Chat, Create, Connect"
NEXT_PUBLIC_SUPPORT_EMAIL="support@gjyl.local"

# Live Streaming
RTMP_URL="rtmp://localhost/live"
HLS_PATH="/var/hls"

# GIF Provider (Tenor)
NEXT_PUBLIC_TENOR_API_KEY=""

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=""

# Feature Flags
NEXT_PUBLIC_AUTH_PROVIDERS="email,google,github"

# Media Limits
MAX_FILE_SIZE_MB="100"
MAX_VIDEO_DURATION_SECONDS="300"
MAX_VOICE_CLIP_SECONDS="120"

# Rate Limits
RATE_LIMIT_FRIEND_REQUESTS_PER_HOUR="10"
RATE_LIMIT_MESSAGES_PER_MINUTE="30"
RATE_LIMIT_UPLOADS_PER_HOUR="20"

# Moderation
ENABLE_AUTO_MODERATION="false"
PROFANITY_FILTER_ENABLED="true"
